{
  "Type": "Generic",
  "NameTranslationKey": "server.npcRoles.Body_Entity.name",
  "StartState": "Sleep",
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Neutral",
  "Appearance": "Player",
  "MaxHealth": 1,
  "Invulnerable": true,
  "KnockbackScale": 0,
  "DisableDamageGroups": ["Self"],
  "BusyStates": ["$Interaction"],
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 0.01,
      "MinWalkSpeed": 0.01,
      "Gravity": 10,
      "MaxFallSpeed": 8,
      "Acceleration": 0.01
    }
  ],
  "Instructions": [
    {
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": "Sleep"
          },
          "Instructions": [
            {
              "Sensor": { "Type": "Any" },
              "BodyMotion": { "Type": "Nothing" },
              "HeadMotion": { "Type": "Nothing" },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Slot": "Status",
                  "Animation": "Sleep"
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": "$Interaction"
          },
          "Instructions": [
            {
              "Sensor": { "Type": "Any" },
              "Actions": [
                {
                  "Type": "Timeout",
                  "Delay": [1, 1],
                  "Action": {
                    "Type": "Sequence",
                    "Actions": [
                      { "Type": "ReleaseTarget" },
                      { "Type": "State", "State": "Sleep" }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Instructions": [
      {
        "Sensor": {
          "Type": "Not",
          "Sensor": { "Type": "CanInteract", "ViewSector": 360 }
        },
        "Actions": [{ "Type": "SetInteractable", "Interactable": false }]
      },
      {
        "Continue": true,
        "Sensor": { "Type": "Any" },
        "Actions": [
          { "Type": "SetInteractable", "Interactable": true }
        ]
      },
      {
        "Sensor": { "Type": "HasInteracted" },
        "Instructions": [
          {
            "Sensor": {
              "Type": "Not",
              "Sensor": { "Type": "State", "State": "$Interaction" }
            },
            "Actions": [
              { "Type": "LockOnInteractionTarget" },
              { "Type": "OpenBody" },
              { "Type": "State", "State": "$Interaction" }
            ]
          }
        ]
      }
    ]
  }
}